{
  "name": "@nesa-africa/backend",
  "version": "0.1.0",
  "private": true,
  "description": "NESA Africa REST API (Express + TypeScript). Deploy to Render / Railway / Fly / VPS.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
